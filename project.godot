[layer_names]

3d_physics/layer_1="Standard"
3d_physics/layer_2="PlayerOnly"
3d_physics/layer_3="HankSight"
3d_physics/layer_4="AudioRaycast"
3d_physics/layer_5="InteractableArea"
3d_physics/layer_6="HankDetect"
3d_physics/layer_7="PlayerToHankVision"
3d_physics/layer_8="BottleSmash"

[navigation]

3d/default_cell_size=0.1
3d/default_cell_height=0.1
3d/default_edge_connection_margin=0.5

[physics]

3d/run_on_separate_thread=true
3d/physics_engine="Jolt Physics"

[raytraced_audio]

reverb_bus=&"RaytracedReverb"
ambient_bus=&"RaytracedAmbient"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
limits/time/time_rollover_secs=1024.0
anti_aliasing/screen_space_roughness_limiter/enabled=false
textures/decals/filter=0
textures/light_projectors/filter=0
environment/glow/upscale_mode=0
limits/opengl/max_lights_per_object=12
occlusion_culling/use_occlusion_culling=true

[shader_globals]

vertex_quant={
"type": "float",
"value": 66.6
}
beyer_matrix={
"type": "sampler2D",
"value": "res://textures/beyer_matrix.png"
}
viewport_width_beyer={
"type": "float",
"value": 80.0
}
viewport_height_beyer={
"type": "float",
"value": 20.0
}
