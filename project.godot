; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hank Maze 3D"
config/version="1.1.0"
run/main_scene="uid://c4y80yjg2gxku"
config/features=PackedStringArray("4.8", "GL Compatibility")
boot_splash/bg_color=Color(0.03797171, 0.035502274, 0.0015411723, 1)
boot_splash/use_filter=false
boot_splash/image="uid://bxkfxg2amquup"
config/icon="uid://box2epxxjxjce"

[audio]

buses/default_bus_layout="uid://c2hriix1p7vup"
general/default_playback_type.web=0

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/raytraced_audio/plugin.cfg")

[filesystem]

import/blender/enabled=false

[global_group]

player_to_hank_vision="Used to detect when we see hank's vision area3d."

[gui]

theme/default_font_antialiasing=0
theme/custom="uid://bm2xy8x82f5ud"

