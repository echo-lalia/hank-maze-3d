3d/default_cell_height=0.1
3d/default_edge_connection_margin=0.5

[physics]

3d/physics_engine="Jolt Physics"

[raytraced_audio]

reverb_bus=&"RaytracedReverb"
ambient_bus=&"RaytracedAmbient"

[rendering]

